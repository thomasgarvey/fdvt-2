---
// Shared page chrome for the archive's secondary pages. Lifted verbatim from
// contact.astro so the masthead, footer, palette and theme toggle stay in step
// with the rest of the site; the homepage keeps its own richer styles.
interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
import Analytics from "../components/Analytics.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      // Same key the homepage uses, so the theme carries across pages.
      try {
        if (localStorage.getItem("fdvt-theme") === "dark") {
          document.documentElement.dataset.theme = "dark";
        }
      } catch (e) {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,300..700;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,300..700;1,8..60,400&display=swap"
    />
    <Analytics />
  </head>

  <body>
    <header class="masthead">
      <div class="wrap mast-in">
        <a class="brand" href="/">
          <svg class="mark" viewBox="0 0 40 40" aria-hidden="true">
            <path d="M8 3h24v22.5L20 37 8 25.5Z" fill="#BC241B"></path>
            <path
              d="M20 9.5c2.6 3 3.9 5.4 3.9 7.2 0 1.3-.6 2.3-1.7 3 .2-1.6-.4-3-1.8-4.4.2 2.6-.7 4.4-2.6 5.6-1.3.8-2 1.9-2 3.2 0 2.3 1.9 4 4.2 4s4.3-1.8 4.3-4.2c0-1-.2-2-.7-3 1.9 1.3 2.9 3 2.9 5.2 0 3.5-2.9 6.2-6.5 6.2s-6.6-2.8-6.6-6.4c0-2.3 1-4.3 3-6.2 2.2-2 3.4-3.7 3.6-5.2Z"
              fill="#F2F1E8"></path>
          </svg>
          <span class="brand-txt">Vermont Fire Stations<span>fdvermont.org</span></span>
        </a>
        <nav class="nav" id="sitenav">
          <a href="/#map">Map</a>
          <a href="/departments">Departments</a>
          <a href="/#about">About</a>
          <a href="/contact">Contact</a>
        </nav>
        <button
          class="navtoggle"
          type="button"
          data-nav-toggle
          aria-controls="sitenav"
          aria-expanded="false"
          aria-label="Menu"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path class="n-open" d="M3.5 6.5h17M3.5 12h17M3.5 17.5h17"></path>
            <path class="n-close" d="M5.5 5.5l13 13M18.5 5.5l-13 13"></path>
          </svg>
        </button>
        <button class="themetoggle" type="button" data-theme-toggle aria-label="Switch color theme">
          <svg class="i-sun" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="4.2"></circle>
            <path d="M12 2.5v2.2M12 19.3v2.2M4.2 4.2l1.6 1.6M18.2 18.2l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.2 19.8l1.6-1.6M18.2 5.8l1.6-1.6"></path>
          </svg>
          <svg class="i-moon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M20 14.2A8.2 8.2 0 0 1 9.8 4a8.2 8.2 0 1 0 10.2 10.2Z"></path>
          </svg>
          <span class="tt-label"><span class="tt-a">Light</span><span class="tt-b">Dark</span></span>
        </button>
      </div>
    </header>

    <slot />

    <footer>
      <div class="wrap foot">
        <span>© {new Date().getFullYear()} Vermont Fire Stations</span>
        <span aria-hidden="true">·</span>
        <a href="/privacy">Privacy Policy</a>
        <span aria-hidden="true">·</span>
        <a href="/contact">Contact</a>
        <span aria-hidden="true">·</span>
        <span>
          Data:
          <a href="https://geodata.vermont.gov/" target="_blank" rel="noopener">VT E911 (VCGI)</a>
          &amp;
          <a href="https://www.openstreetmap.org/" target="_blank" rel="noopener">OpenStreetMap</a>
        </span>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      document.querySelectorAll("[data-theme-toggle]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const dark = root.dataset.theme !== "dark";
          if (dark) root.dataset.theme = "dark";
          else delete root.dataset.theme;
          try {
            localStorage.setItem("fdvt-theme", dark ? "dark" : "light");
          } catch (e) {}
        });
      });

      // Mobile menu. The nav is hidden by CSS on small screens; this button is
      // the only way to reach it there, so it stays keyboard- and SR-friendly.
      document.querySelectorAll("[data-nav-toggle]").forEach((btn) => {
        const nav = document.getElementById(btn.getAttribute("aria-controls"));
        if (!nav) return;
        const setOpen = (open) => {
          btn.setAttribute("aria-expanded", String(open));
          nav.classList.toggle("is-open", open);
        };
        btn.addEventListener("click", () =>
          setOpen(btn.getAttribute("aria-expanded") !== "true"),
        );
        // Close on Escape, and when a link is followed (same-page anchors do
        // not reload, so the panel would otherwise stay open over the content).
        nav.addEventListener("click", (e) => {
          if (e.target.closest("a")) setOpen(false);
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") setOpen(false);
        });
      });
    </script>
  </body>
</html>

<style is:global>
:root {
    color-scheme: light;
    --paper: #f3ebdd;
    --surface: #faf7f0;
    --ink: #394044;
    --ink-2: #5c6469;
    --ink-3: #8a8177;
    --line: #ddd2c0;
    --brass: #b08a4a;
    --red: #8b211e;
    --red-deep: #541c1a;
    --charcoal: #242526;
    --shadow: 0 1px 2px rgba(36, 37, 38, 0.06), 0 12px 30px rgba(36, 37, 38, 0.09);
  }
:root[data-theme="dark"] {
    color-scheme: dark;
    --paper: #1a1918;
    --surface: #232120;
    --ink: #e8e0d2;
    --ink-2: #a9a093;
    --ink-3: #7e766b;
    --line: #383431;
    --brass: #c9a45e;
    --red: #b8453c;
    --red-deep: #8b211e;
    --charcoal: #14100e;
    --shadow: 0 1px 2px rgba(0, 0, 0, 0.45), 0 14px 34px rgba(0, 0, 0, 0.4);
  }
/* A link that opens a new tab changes context without warning, so mark it.
     Decorative only: the "/ ''" gives the glyph empty alt text so screen readers
     do not read out an arrow. Older engines reject that syntax, hence the plain
     declaration first and the @supports override after. */
  a[target="_blank"]::after {
    content: "\2197";
    font-size: 0.76em;
    line-height: 1;
    margin-left: 0.16em;
    vertical-align: 0.14em;
    opacity: 0.65;
  }
  @supports (content: "a" / "b") {
    a[target="_blank"]::after { content: "\2197" / ""; }
  }
  /* Leaflet's attribution is ten pixels of credit in the map corner, and the
     apply button already ends in an arrow of its own. */
  .leaflet-container a[target="_blank"]::after,
  a.btn[target="_blank"]::after { content: none; }

body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: "Source Sans 3", -apple-system, "Segoe UI", sans-serif;
    font-size: 17px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
.wrap {
    width: min(1180px, 100% - 3rem);
    margin-inline: auto;
  }
.masthead {
    border-bottom: 3px solid var(--red-deep);
    background: var(--charcoal);
    padding: 1.1rem 0;
  }
.mast-in {
    display: flex;
    align-items: center;
    gap: 1.6rem;
  }
.brand {
    display: flex;
    align-items: center;
    gap: 0.72rem;
    text-decoration: none;
    color: var(--ink);
  }
.mark {
    width: 34px;
    height: 34px;
    flex: none;
  }
.brand-txt {
    font-family: inherit;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    font-size: 0.86rem;
    line-height: 1.05;
  }
.brand-txt span {
    display: block;
    font-weight: 500;
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    color: var(--ink-3);
  }
.nav {
    margin-left: auto;
    display: flex;
    gap: 1.4rem;
  }
.nav a {
    font-family: inherit;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-2);
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
  }
.nav a:hover {
    color: var(--ink);
    border-color: var(--red);
  }
.themetoggle {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    cursor: pointer;
    background: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.34rem 0.72rem;
    color: var(--ink-2);
    font-family: inherit;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    transition: color 0.18s, border-color 0.18s;
  }
.themetoggle:hover {
    color: var(--ink);
    border-color: var(--ink-3);
  }
.themetoggle .i-sun,
  .themetoggle .tt-a {
    display: none;
  }
:root[data-theme="dark"] .themetoggle .i-moon,
  :root[data-theme="dark"] .themetoggle .tt-b {
    display: none;
  }
:root[data-theme="dark"] .themetoggle .i-sun {
    display: block;
  }
:root[data-theme="dark"] .themetoggle .tt-a {
    display: inline;
  }
footer {
    border-top: 1px solid var(--line);
    background: var(--surface);
    padding: 1.8rem 0 2.2rem;
  }
.foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    font-family: inherit;
    font-size: 0.8rem;
    color: var(--ink-2);
  }
.foot a {
    color: inherit;
    text-decoration: underline;
  }
.foot a:hover {
    color: var(--red);
  }

/* --- Responsive chrome ------------------------------------------------- */
/* The nav is the only way around the site, so on small screens it becomes a
   disclosure panel rather than disappearing. */
.navtoggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-left: 0.35rem;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: none;
    color: var(--ink-2);
    cursor: pointer;
  }
.navtoggle:hover { color: var(--ink); border-color: var(--red); }
.navtoggle .n-close { display: none; }
.navtoggle[aria-expanded="true"] .n-open { display: none; }
.navtoggle[aria-expanded="true"] .n-close { display: block; }

/* Comfortable touch targets everywhere (44px is the usual minimum). */
@media (pointer: coarse) {
  .nav a, footer a, .foot a { min-height: 44px; display: inline-flex; align-items: center; }
  .themetoggle { min-height: 44px; }
}

@media (max-width: 780px) {
  .mast-in { flex-wrap: wrap; gap: 0.6rem 1rem; }
  .brand { flex: 1 1 auto; min-width: 0; }
  .themetoggle { margin-left: auto; }
  .navtoggle { display: inline-flex; }
  .nav {
    display: none;
    order: 10;
    flex-basis: 100%;
    margin-left: 0;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--line);
    padding-top: 0.3rem;
  }
  .nav.is-open { display: flex; }
  .nav a {
    padding: 0.85rem 0.1rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.85rem;
  }
  .nav a:last-child { border-bottom: 0; }
  .foot { flex-direction: column; gap: 0.15rem; text-align: center; }
}
</style>
