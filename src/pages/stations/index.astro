---
import Archive from "../../layouts/Archive.astro";
import { stations, photographedCount } from "../../lib/stations";
import { townSlugForStation } from "../../lib/towns";

// Grouped by town so the list reads as a gazetteer rather than 274 flat rows.
const byTown = new Map<string, typeof stations>();
for (const s of stations) {
  if (!byTown.has(s.town)) byTown.set(s.town, []);
  byTown.get(s.town)!.push(s);
}
const towns = [...byTown.entries()].sort((a, b) => a[0].localeCompare(b[0]));
const counties = new Set(stations.map((s) => s.county).filter(Boolean)).size;
---

<Archive
  title="Every fire station in Vermont – Vermont Fire Stations"
  description={`An index of all ${stations.length} fire stations recorded in Vermont, by town, with photographs where we have them.`}
>
  <main class="wrap page">
    <header class="head">
      <h1>Every station in the archive</h1>
      <p class="sub">
        {stations.length} stations across {towns.length} towns and {counties} counties, from the
        Vermont E911 site file. {photographedCount} have been photographed so far — the rest are
        waiting. <a href="/contact">Send a photograph</a> if you have one.
      </p>
    </header>

    <nav class="atoz" aria-label="Jump to town">
      {[...new Set(towns.map(([t]) => t[0]))].map((letter) => (
        <a href={`#letter-${letter}`}>{letter}</a>
      ))}
    </nav>

    {towns.map(([town, list], i) => {
      const letter = town[0];
      const first = towns.findIndex(([t]) => t[0] === letter) === i;
      return (
        <section class="town" id={first ? `letter-${letter}` : undefined}>
          <h2><a href={`/towns/${townSlugForStation(list[0])}`}>{town}</a></h2>
          <ul>
            {list.map((s) => (
              <li>
                <a href={`/stations/${s.slug}`}>
                  <span class="dot" data-has={s.photo ? "yes" : "no"} aria-hidden="true"></span>
                  <span class="nm">{s.name}</span>
                  <span class="ad">{s.address}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      );
    })}
  </main>
</Archive>

<style>
  .page { padding: 2.4rem 0 3.4rem; max-width: 52rem; }
  .head { margin-bottom: 1.6rem; }
  h1 {
    font-family: "Source Serif 4", Georgia, serif;
    font-size: clamp(1.7rem, 4vw, 2.4rem); line-height: 1.15; margin: 0 0 0.5rem;
  }
  .sub { margin: 0; color: var(--ink-2); font-size: 0.96rem; max-width: 40rem; }
  .sub a { color: var(--red); }
  .atoz {
    display: flex; flex-wrap: wrap; gap: 0.35rem; margin: 1.4rem 0 2rem;
    padding-bottom: 1rem; border-bottom: 1px solid var(--line);
  }
  .atoz a {
    font-size: 0.76rem; font-weight: 700; letter-spacing: 0.06em;
    text-decoration: none; color: var(--ink-2);
    border: 1px solid var(--line); padding: 0.18rem 0.46rem; border-radius: 2px;
  }
  .atoz a:hover { color: #fff; background: var(--red); border-color: var(--red); }
  .town { margin-bottom: 1.7rem; scroll-margin-top: 1rem; }
  .town h2 a {
    color: inherit; text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .town h2 a:hover { color: var(--red); border-color: var(--red); }
  h2 {
    font-family: "Source Serif 4", Georgia, serif; font-size: 1.05rem;
    margin: 0 0 0.4rem; color: var(--ink);
  }
  ul { list-style: none; margin: 0; padding: 0; }
  li { border-top: 1px solid var(--line); }
  a.station { text-decoration: none; }
  li a {
    display: grid; grid-template-columns: 14px 1fr auto; align-items: center;
    gap: 0.65rem; padding: 0.5rem 0; text-decoration: none; color: var(--ink);
    font-size: 0.93rem;
  }
  li a:hover .nm { color: var(--red); }
  .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--ink-3); }
  .dot[data-has="yes"] { background: var(--red); }
  .ad { color: var(--ink-3); font-size: 0.83rem; text-align: right; }
  @media (max-width: 560px) {
    li a { grid-template-columns: 14px 1fr; }
    .ad { grid-column: 2; text-align: left; }
  }
</style>
