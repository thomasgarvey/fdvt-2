---
import Analytics from "../components/Analytics.astro";

// The public-facing address. It's a Namecheap forwarding alias on
// fdvermont.org, not a personal inbox, so it can be changed or retired
// without touching anything else on the site — change it here and the
// three links below follow.
const EMAIL = "hello@fdvermont.org";

const mail = (subject: string, body: string) =>
  `mailto:${EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

const ways = [
  {
    id: "photo",
    title: "Submit a photo",
    blurb:
      "Shot a station that's still a slate marker on the map? Attach the photo and I'll add it, credited to you.",
    action: "Email a photo",
    href: mail("Station photo for FD Vermont", [
      "Department:",
      "Town:",
      "Roughly when you took it:",
      "How you'd like to be credited:",
      "",
      "(attach the photo to this email)",
    ].join("\n")),
  },
  {
    id: "correction",
    title: "Correct a record",
    blurb:
      "Wrong address, a station that's closed, a department renamed or merged? Corrections get fixed at the source and flow back into the map.",
    action: "Send a correction",
    href: mail("Correction for FD Vermont", [
      "Department or station:",
      "What's wrong:",
      "What it should be:",
      "Source, if you have one:",
    ].join("\n")),
  },
  {
    id: "general",
    title: "Anything else",
    blurb:
      "Questions about the project, a station worth photographing, or an idea for the site.",
    action: "Get in touch",
    href: mail("FD Vermont", ""),
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <title>Contact – Vermont Fire Stations</title>
    <meta
      name="description"
      content="Send a station photo, a correction, or a question to the Vermont Fire Stations archive."
    />
    <script is:inline>
      // Same key the homepage uses, so the theme carries across pages.
      try {
        if (localStorage.getItem("fdvt-theme") === "dark") {
          document.documentElement.dataset.theme = "dark";
        }
      } catch (e) {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,300..700;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,300..700;1,8..60,400&display=swap"
    />
    <Analytics />
  </head>

  <body>
    <header class="masthead">
      <div class="wrap mast-in">
        <a class="brand" href="/">
          <svg class="mark" viewBox="0 0 40 40" aria-hidden="true">
            <path d="M8 3h24v22.5L20 37 8 25.5Z" fill="#BC241B"></path>
            <path
              d="M20 9.5c2.6 3 3.9 5.4 3.9 7.2 0 1.3-.6 2.3-1.7 3 .2-1.6-.4-3-1.8-4.4.2 2.6-.7 4.4-2.6 5.6-1.3.8-2 1.9-2 3.2 0 2.3 1.9 4 4.2 4s4.3-1.8 4.3-4.2c0-1-.2-2-.7-3 1.9 1.3 2.9 3 2.9 5.2 0 3.5-2.9 6.2-6.5 6.2s-6.6-2.8-6.6-6.4c0-2.3 1-4.3 3-6.2 2.2-2 3.4-3.7 3.6-5.2Z"
              fill="#F2F1E8"></path>
          </svg>
          <span class="brand-txt">Vermont Fire Stations<span>fdvermont.org</span></span>
        </a>
        <nav class="nav">
          <a href="/#map">Map</a>
          <a href="/#stations">Firehouses</a>
          <a href="/#about">About</a>
        </nav>
        <button class="themetoggle" type="button" data-theme-toggle aria-label="Switch color theme">
          <svg class="i-sun" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="4.2"></circle>
            <path d="M12 2.5v2.2M12 19.3v2.2M4.2 4.2l1.6 1.6M18.2 18.2l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.2 19.8l1.6-1.6M18.2 5.8l1.6-1.6"></path>
          </svg>
          <svg class="i-moon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M20 14.2A8.2 8.2 0 0 1 9.8 4a8.2 8.2 0 1 0 10.2 10.2Z"></path>
          </svg>
          <span class="tt-label"><span class="tt-a">Light</span><span class="tt-b">Dark</span></span>
        </button>
      </div>
    </header>

    <main class="wrap">
      <p class="eyebrow">Contact</p>
      <h1>Send a photo, or set the record straight.</h1>
      <p class="lede">
        Vermont Fire Stations is an independent archive of the state's firehouses — photos,
        locations, and department details, kept up to date by the people who know these
        stations best. Everything below goes to one inbox and gets read.
      </p>

      <div class="ways">
        {ways.map((w) => (
          <article class="way" id={w.id}>
            <h2>{w.title}</h2>
            <p>{w.blurb}</p>
            <a class="cta" href={w.href}>{w.action} →</a>
          </article>
        ))}
      </div>

      <p class="note">
        Every link opens your email app with a message started for you. If it doesn't,
        write to <a href={mail("FD Vermont", "")}>{EMAIL}</a> directly.
      </p>

      <section class="terms" aria-labelledby="terms-h">
        <h2 id="terms-h">Using your photographs</h2>
        <p>
          Photographs remain the copyright of the photographer. Sending one grants Vermont
          Fire Stations permission to publish it on this site with credit. Tell me you'd
          like it removed and it comes down.
        </p>
      </section>

      <p class="back"><a href="/">← Back to the map</a></p>
    </main>

    <footer>
      <div class="wrap foot">
        <span>© {new Date().getFullYear()} Vermont Fire Stations</span>
        <span aria-hidden="true">·</span>
        <a href="/privacy">Privacy Policy</a>
        <span aria-hidden="true">·</span>
        <a href="/contact">Contact</a>
        <span aria-hidden="true">·</span>
        <span>
          Data:
          <a href="https://geodata.vermont.gov/" target="_blank" rel="noopener">VT E911 (VCGI)</a>
          &amp;
          <a href="https://www.openstreetmap.org/" target="_blank" rel="noopener">OpenStreetMap</a>
        </span>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      document.querySelectorAll("[data-theme-toggle]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const dark = root.dataset.theme !== "dark";
          if (dark) root.dataset.theme = "dark";
          else delete root.dataset.theme;
          try {
            localStorage.setItem("fdvt-theme", dark ? "dark" : "light");
          } catch (e) {}
        });
      });
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --paper: #f3ebdd;
    --surface: #faf7f0;
    --ink: #394044;
    --ink-2: #5c6469;
    --ink-3: #8a8177;
    --line: #ddd2c0;
    --brass: #b08a4a;
    --red: #8b211e;
    --red-deep: #541c1a;
    --charcoal: #242526;
    --shadow: 0 1px 2px rgba(36, 37, 38, 0.06), 0 12px 30px rgba(36, 37, 38, 0.09);
  }
  :root[data-theme="dark"] {
    color-scheme: dark;
    --paper: #1a1918;
    --surface: #232120;
    --ink: #e8e0d2;
    --ink-2: #a9a093;
    --ink-3: #7e766b;
    --line: #383431;
    --brass: #c9a45e;
    --red: #b8453c;
    --red-deep: #8b211e;
    --charcoal: #14100e;
    --shadow: 0 1px 2px rgba(0, 0, 0, 0.45), 0 14px 34px rgba(0, 0, 0, 0.4);
  }

  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: "Source Sans 3", -apple-system, "Segoe UI", sans-serif;
    font-size: 17px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  h1,
  h2 {
    font-family: "Source Serif 4", Georgia, "Times New Roman", serif;
  }
  a {
    color: inherit;
  }
  :focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 3px;
  }
  .wrap {
    width: min(1180px, 100% - 3rem);
    margin-inline: auto;
  }
  .eyebrow {
    font-family: inherit;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin: 0 0 0.7rem;
  }

  .masthead {
    border-bottom: 3px solid var(--red-deep);
    background: var(--charcoal);
    padding: 1.1rem 0;
  }
  .mast-in {
    display: flex;
    align-items: center;
    gap: 1.6rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.72rem;
    text-decoration: none;
    color: var(--ink);
  }
  .mark {
    width: 34px;
    height: 34px;
    flex: none;
  }
  .brand-txt {
    font-family: inherit;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    font-size: 0.86rem;
    line-height: 1.05;
  }
  .brand-txt span {
    display: block;
    font-weight: 500;
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    color: var(--ink-3);
  }
  .nav {
    margin-left: auto;
    display: flex;
    gap: 1.4rem;
  }
  .nav a {
    font-family: inherit;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-2);
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
  }
  .nav a:hover {
    color: var(--ink);
    border-color: var(--red);
  }
  @media (max-width: 780px) {
    .nav {
      display: none;
    }
    .themetoggle {
      margin-left: auto;
    }
  }

  .themetoggle {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    cursor: pointer;
    background: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.34rem 0.72rem;
    color: var(--ink-2);
    font-family: inherit;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    transition: color 0.18s, border-color 0.18s;
  }
  .themetoggle:hover {
    color: var(--ink);
    border-color: var(--ink-3);
  }
  .themetoggle .i-sun,
  .themetoggle .tt-a {
    display: none;
  }
  :root[data-theme="dark"] .themetoggle .i-moon,
  :root[data-theme="dark"] .themetoggle .tt-b {
    display: none;
  }
  :root[data-theme="dark"] .themetoggle .i-sun {
    display: block;
  }
  :root[data-theme="dark"] .themetoggle .tt-a {
    display: inline;
  }

  main {
    flex: 1;
    padding: 4.5rem 0 5rem;
  }
  h1 {
    margin: 0 0 1.1rem;
    font-weight: 700;
    font-size: clamp(2rem, 4.4vw, 3.2rem);
    line-height: 1.02;
    letter-spacing: -0.022em;
    max-width: 17ch;
    text-wrap: balance;
  }
  .lede {
    margin: 0 0 3rem;
    max-width: 58ch;
    font-size: 1.1rem;
    color: var(--ink-2);
  }

  .ways {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }
  .way {
    border: 1px solid var(--line);
    background: var(--surface);
    border-radius: 3px;
    padding: 1.7rem 1.6rem 1.5rem;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow);
  }
  .way h2 {
    margin: 0 0 0.5rem;
    font-weight: 700;
    font-size: 1.24rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .way p {
    margin: 0 0 1.6rem;
    color: var(--ink-2);
    font-size: 0.98rem;
  }
  .cta {
    margin-top: auto;
    align-self: flex-start;
    font-family: inherit;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--red);
    border-bottom: 2px solid currentColor;
    padding-bottom: 2px;
  }
  .cta:hover {
    color: var(--ink);
  }
  @media (max-width: 860px) {
    .ways {
      grid-template-columns: 1fr;
    }
  }

  .note {
    margin: 2.6rem 0 0;
    max-width: 58ch;
    font-size: 0.95rem;
    color: var(--ink-2);
  }
  .terms {
    margin: 2.2rem 0 0;
    max-width: 58ch;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }
  .terms h2 {
    font-family: "Source Serif 4", Georgia, serif;
    font-size: 1.05rem;
    margin: 0 0 0.45rem;
  }
  .terms p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--ink-2);
  }
  .note a {
    color: var(--red);
  }
  .back {
    margin: 2.4rem 0 0;
    font-family: inherit;
    font-size: 0.8rem;
  }
  .back a {
    text-decoration: none;
    color: var(--ink-2);
  }
  .back a:hover {
    color: var(--ink);
  }

  footer {
    border-top: 1px solid var(--line);
    background: var(--surface);
    padding: 1.8rem 0 2.2rem;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    font-family: inherit;
    font-size: 0.8rem;
    color: var(--ink-2);
  }
  .foot a {
    color: inherit;
    text-decoration: underline;
  }
  .foot a:hover {
    color: var(--red);
  }
</style>
